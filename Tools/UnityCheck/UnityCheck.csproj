    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0436;CS0649;CS0169</NoWarn>
    <UnityManaged>C:\Program Files\Unity\Hub\Editor\6000.3.11f1\Editor\Data\Managed</UnityManaged>
    <Game>C:\UNITY_LG\SelfProduction\Assets\Games</Game>
